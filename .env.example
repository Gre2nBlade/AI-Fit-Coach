# ===== AI provider (OpenRouter) =====
OPENROUTER_API_KEY=sk-or-put-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Основная модель: текстовые ответы и генерация планов.
AI_MODEL=openai/gpt-oss-120b:free
# Vision-модель: анализ фото в чате.
AI_VISION_MODEL=google/gemma-4-26b-a4b-it:free
# Лимиты длины ответа (короче = быстрее).
AI_MAX_TOKENS=800
AI_PLAN_MAX_TOKENS=1500

# ===== Database =====
# SQLite сейчас. При переезде на Postgres поменять только эту строку:
# postgresql+asyncpg://user:pass@localhost/fitcoach
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ===== JWT =====
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ===== API server (FastAPI) =====
API_HOST=0.0.0.0
API_PORT=8000
# CORS: домены фронта/мобилки через запятую. Черновик — ["*"].
# CORS_ORIGINS=["https://yourapp.com","capacitor://localhost"]

# ===== Admin =====
# Секрет для входа в админ-панель. На странице входа: email = admin, пароль = этот секрет.
ADMIN_SECRET=CHANGE_ME_ADMIN_SECRET

# ===== Misc =====
LOG_LEVEL=INFO
CACHE_TTL=300
