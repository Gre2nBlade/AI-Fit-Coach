# ===== AI provider (OpenRouter) =====
OPENROUTER_API_KEY=sk-or-put-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-3.5-sonnet

# ===== Database =====
# SQLite сейчас. При переезде на Postgres поменять только эту строку:
# postgresql+asyncpg://user:pass@localhost/fitcoach
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ===== JWT =====
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ===== API server (FastAPI) =====
API_HOST=0.0.0.0
API_PORT=8000
# CORS: домены фронта/мобилки через запятую. Черновик — ["*"].
# CORS_ORIGINS=["https://yourapp.com","capacitor://localhost"]

# ===== Misc =====
LOG_LEVEL=INFO
CACHE_TTL=300
