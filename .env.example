# ===== Telegram =====
BOT_TOKEN=123456:PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE

# ===== AI provider (OpenRouter) =====
OPENROUTER_API_KEY=sk-or-put-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-3.5-sonnet

# ===== Database =====
# SQLite сейчас. При переезде на Postgres поменять только эту строку:
# postgresql+asyncpg://user:pass@localhost/fitcoach
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# ===== API server (FastAPI) =====
API_HOST=0.0.0.0
API_PORT=8000

# Публичный URL MiniApp (для кнопки в боте), напр. https://example.com
WEBAPP_URL=https://example.com

# ===== Misc =====
LOG_LEVEL=INFO
CACHE_TTL=300
